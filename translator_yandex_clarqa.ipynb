    "# Настройки\n",
    "SOURCE_REPO_ID = \"DeepPavlov/clarqa\"\n",
    "LOCAL_SAVE_PATH = \"./clarqa_ru\"\n",
    "CACHE_FILE = \"translation_cache.jsonl\"\n",
    "\n",
    "# Конфигурации и сплиты\n",
    "CONFIGS = ['single_turn', 'multi_turn']\n",
    "SPLITS = ['train', 'dev', 'test']"
   ]
